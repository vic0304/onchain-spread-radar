# Optional: OKX API credentials unlock the monthly included quota for the
# Hot Token Basic endpoint. Create a read-only key and keep this file private.
OKX_ACCESS_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Optional, only after the OKX included quota is exhausted. Supply an
# already-authorized X-PAYMENT value; never put a wallet private key here.
OKX_X402_PAYMENT=

# Per-contract tax and trading-risk checks. Candidates with unknown tax,
# modifiable tax, or a buy/sell tax above the limit are rejected.
# Create an access token in the GoPlus console and keep it local.
GOPLUS_ACCESS_TOKEN=
GOPLUS_MAX_TOKEN_TAX_BPS=500

# Telegram alerts are sent by a Bot to a chat that has already started it.
# Create the bot with @BotFather, then keep its token local. Do not paste it
# into the dashboard, chat, or source control.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The public username of the same dedicated Bot, without @. This is required
# before sending, so a copied token for another project cannot be used here.
TELEGRAM_EXPECTED_BOT_USERNAME=

# Optional alert controls. The defaults are deliberately conservative.
TELEGRAM_POLL_SECONDS=90
TELEGRAM_ALERT_COOLDOWN_SECONDS=900
TELEGRAM_ALERT_MAX_PER_SCAN=3

# Optional HTTP proxy when this computer cannot reach api.telegram.org directly.
# Example: http://127.0.0.1:7890
TELEGRAM_PROXY_URL=
